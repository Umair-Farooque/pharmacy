{
  "name": "pharmacy-management",
  "version": "1.0.0",
  "description": "Medical Store Inventory Management System with Electron, React, and MySQL",
  "main": "electron.js",
  "keywords": ["pharmacy", "inventory", "electron", "medical-store"],
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node src/backend/server.js",
    "dev": "concurrently \"npm run server\" \"electron .\"",
    "build": "node scripts/build-frontend.js",
    "build:win": "electron-builder --win",
    "build:server": "electron-builder --win --dir"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "electron-pos-printer": "^1.1.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.2",
    "pdfkit": "^0.13.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^26.6.10",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "tailwindcss": "^3.3.3"
  },
  "build": {
    "appId": "com.pharmacy.management",
    "productName": "Pharmacy Management",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "forceCodeSigning": false,
    "files": [
      "electron.js",
      "preload.js",
      "src/**/*",
      "public/**/*"
    ],
    "asar": false,
    "extraResources": []
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
