# Server Configuration
PORT=3000

# Database Configuration
# Set USE_MYSQL=true to use MySQL instead of SQLite
USE_MYSQL=false

# MySQL credentials (only needed if USE_MYSQL=true)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pharmacy_db

# JWT Secret (change this to a secure random string in production)
JWT_SECRET=change_this_to_something_secure_in_production

# Server IP for multi-PC setup (set to the static LAN IP of this PC)
SERVER_IP=192.168.1.100
